{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Transaction",
  "description": "Opération bancaire entrante (topic transactions.raw). Vocabulaire ISO 20022 : debtor = donneur d'ordre, creditor = bénéficiaire. Montant en unités mineures entières (centimes pour EUR). v2 : ajoute payment_format (facultatif), le moyen de paiement d'origine.",
  "type": "object",
  "properties": {
    "transaction_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "booked_at": {
      "type": "string",
      "format": "date-time"
    },
    "payment_type": {
      "type": "string",
      "enum": [
        "transfer",
        "cash_deposit",
        "cash_withdrawal"
      ]
    },
    "debtor_iban": {
      "type": "string"
    },
    "creditor_iban": {
      "type": "string"
    },
    "amount_minor": {
      "type": "integer",
      "minimum": 1
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "payment_format": {
      "type": "string",
      "enum": [
        "ach",
        "cheque",
        "credit_card",
        "cash",
        "wire",
        "bitcoin"
      ]
    }
  },
  "required": [
    "transaction_id",
    "booked_at",
    "payment_type",
    "amount_minor",
    "currency"
  ]
}
